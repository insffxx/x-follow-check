{
  "manifest_version": 3,
  "name": "X 回关检查",
  "version": "1.3.0",
  "description": "一键找出你关注的人里谁没回关、谁关注后又取关了你、谁不是蓝V，并直接跳到对方的「正在关注」按钮，方便你手动取关；「取关了我」名单可逐个一键移出列表、屏蔽并举报垃圾信息（需确认）。不会自动关注或批量操作。",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "X 回关检查",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://abs.twimg.com/*",
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}